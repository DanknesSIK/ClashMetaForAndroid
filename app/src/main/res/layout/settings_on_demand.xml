<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fitsSystemWindows="true" android:fillViewport="true">
    <LinearLayout android:orientation="vertical"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/on_demand" android:textAppearance="?attr/textAppearanceHeadline5" />
        <androidx.appcompat.widget.SwitchCompat android:id="@+id/on_demand_enabled"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="60dp"
            android:text="@string/on_demand_enable" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/on_demand_explanation" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:labelFor="@id/on_demand_names"
            android:text="@string/on_demand_home" />
        <EditText android:id="@+id/on_demand_names" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minLines="2" android:maxLines="6"
            android:gravity="top|start" android:inputType="textMultiLine|textNoSuggestions"
            android:hint="@string/on_demand_enter_name" />
        <Button android:id="@+id/on_demand_save" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_gravity="end"
            android:text="@string/on_demand_save" />
    </LinearLayout>
</ScrollView>
